<windows:IxWindow x:Class="Index.App.Views.MainShell"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:Index.App.Views"
                  xmlns:controls="clr-namespace:Index.UI.Controls;assembly=Index.UI"
                  xmlns:domain="clr-namespace:Index.Domain;assembly=Index.Domain"
                  xmlns:windows="clr-namespace:Index.UI.Windows;assembly=Index.UI"
                  xmlns:prism="http://prismlibrary.com/"
                  Width="1280"
                  Height="720"
                  MinWidth="960"
                  MinHeight="560"
                  prism:ViewModelLocator.AutoWireViewModel="True"
                  WindowStartupLocation="CenterScreen"
                  TitleBarIcon="{StaticResource Path.IndexLogo}"
                  mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0"
                        prism:RegionManager.RegionName="{x:Static domain:RegionKeys.DataExplorerRegion}" />

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ToolTip="Resize the asset list" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TabControl x:Name="EditorTabs"
                        Grid.Row="0"
                        prism:RegionManager.RegionName="{x:Static domain:RegionKeys.EditorDocumentRegion}" />

            <Border Grid.Row="0"
                    Margin="24"
                    Panel.ZIndex="1"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasItems, ElementName=EditorTabs, Converter={StaticResource InverseVisibilityConverter}}">
                <StackPanel MaxWidth="420">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="No asset open"
                               Foreground="{DynamicResource Brushes.Foreground.Static}" />
                    <TextBlock Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Double-click a texture, model, or text asset in Data Explorer to preview it here."
                               Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ToolTip="Resize the jobs and log panel"
                          IsEnabled="{Binding ElementName=BottomPanelTabExpander, Path=IsExpanded}"/>

            <controls:IxTabExpander x:Name="BottomPanelTabExpander"
                                    Grid.Row="2"
                                    prism:RegionManager.RegionName="{x:Static domain:RegionKeys.BottomPanelRegion}">
            </controls:IxTabExpander>
        </Grid>

    </Grid>

</windows:IxWindow>
