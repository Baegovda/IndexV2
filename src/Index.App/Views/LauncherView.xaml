<windows:IxWindow x:Class="Index.App.Views.LauncherView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:controls="clr-namespace:Index.UI.Controls;assembly=Index.UI"
                  xmlns:prism="http://prismlibrary.com/"
                  xmlns:ui="clr-namespace:Index.UI;assembly=Index.UI"
                  xmlns:windows="clr-namespace:Index.UI.Windows;assembly=Index.UI"
                  xmlns:Extensions="clr-namespace:Index.UI.Extensions;assembly=Index.UI"
                  Width="800"
                  Height="480"
                  MinWidth="640"
                  MinHeight="420"
                  WindowStartupLocation="CenterScreen"
                  SizeToContent="Manual"
                  ResizeMode="CanResize"
                  mc:Ignorable="d">
    <windows:IxWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Index.UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </windows:IxWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="16,14,16,10">
            <TextBlock Text="Games"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brushes.Foreground.Static}" />
            <TextBlock Margin="0,4,0,0"
                       Text="Add a game folder, select it, and launch. Double-click a row to open the editor."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="16,0,16,8">
            <ListView x:Name="gameConfigList"
                      ItemsSource="{Binding Path=Items}"
                      SelectedItem="{Binding Path=SelectedItem}"
                      Extensions:ListViewColumns.Stretch="LastColumn">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}"
                           BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Extensions:DoubleClickBehavior.Command" Value="{Binding ElementName=gameConfigList, Path=DataContext.LaunchCommand}" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.Columns>
                            <GridViewColumn Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="40"
                                                Height="40"
                                                Margin="8,6"
                                                VerticalAlignment="Center"
                                                CornerRadius="3"
                                                BorderThickness="2">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#909090" />
                                                    <GradientStop Offset="1" Color="#303030" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.Background>
                                                <ImageBrush Stretch="Uniform"
                                                            ImageSource="{Binding Path=GameIcon}" />
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Game"
                                            Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Text="{Binding Path=GameName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path=GameName}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding Path=GamePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path=GamePath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView.Columns>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Panel.ZIndex="2"
                    Background="{DynamicResource Brushes.Background.Static}"
                    Visibility="{Binding HasItems, Converter={StaticResource InverseVisibilityConverter}}">
                <StackPanel MaxWidth="440"
                            Margin="24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="No games added"
                               Foreground="{DynamicResource Brushes.Foreground.Static}" />
                    <TextBlock Margin="0,8,0,16"
                               Text="Choose the folder that contains a supported game. Index detects Halo: Combat Evolved Anniversary, Halo 2 Anniversary, and other installed profiles."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
                    <controls:IxButton HorizontalAlignment="Center"
                                       Content="Add Game"
                                       Padding="12,4"
                                       Icon="{x:Static ui:SegoeIcon.Add}"
                                       ToolTip="Choose a folder that contains a supported game"
                                       Command="{Binding ScanPathCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0,16,8"
                Padding="10,8"
                Background="{DynamicResource Brushes.Secondary.Background.Static}"
                BorderBrush="{DynamicResource Brushes.Accent.Static}"
                BorderThickness="3,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brushes.Foreground.Static}" />
        </Border>

        <Border Grid.Row="3"
                Padding="12,8"
                Background="{DynamicResource Brushes.Secondary.Background.Static}"
                BorderBrush="{DynamicResource Brushes.Secondary.Border.Static}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <controls:IxButton Content="Add Game"
                                       Padding="10,4"
                                       Icon="{x:Static ui:SegoeIcon.Add}"
                                       ToolTip="Choose a folder that contains a supported game"
                                       Command="{Binding ScanPathCommand}" />
                    <controls:IxButton Content="Remove"
                                       Padding="10,4"
                                       Icon="{x:Static ui:SegoeIcon.Cancel}"
                                       ToolTip="Remove the selected game from this list"
                                       Command="{Binding RemoveSelectedPathCommand}"
                                       IsEnabled="{Binding ElementName=gameConfigList, Path=SelectedItems.Count}" />
                </StackPanel>

                <controls:IxButton DockPanel.Dock="Right"
                                   Content="Launch"
                                   MinWidth="108"
                                   Padding="12,4"
                                   IsDefault="True"
                                   Icon="{x:Static ui:SegoeIcon.Play}"
                                   ToolTip="Open the selected game"
                                   Command="{Binding LaunchCommand}"
                                   IsEnabled="{Binding ElementName=gameConfigList, Path=SelectedItems.Count}" />
            </DockPanel>
        </Border>
    </Grid>
</windows:IxWindow>
