<UserControl x:Class="Suckdex.Modules.DataExplorer.Views.DataExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Suckdex.Modules.DataExplorer.Views"
             xmlns:controls="clr-namespace:Suckdex.UI.Controls;assembly=Suckdex.UI"
             xmlns:commands="clr-namespace:Suckdex.UI.Commands;assembly=Suckdex.UI"
             xmlns:ui="clr-namespace:Suckdex.UI;assembly=Suckdex.UI"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Suckdex.Modules.DataExplorer.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:DataExplorerViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="720"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Suckdex.UI;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTemplate x:Key="FavoriteExpanderTemplate" TargetType="{x:Type Expander}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Top"
                                  Focusable="False"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Padding="6,2"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="{DynamicResource Brushes.Tertiary.Border.Static}"
                                        Background="{DynamicResource Brushes.Tertiary.Background.Static}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Chevron"
                                              Width="8"
                                              Height="8"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              Data="M 4 0 L 8 4 L 4 8 Z"
                                              Fill="{DynamicResource Brushes.Foreground.Static}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brushes.Foreground.Static}"
                                                   Text="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="ContentSite" DockPanel.Dock="Bottom" />
                </DockPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="False">
                        <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="3,0"
                Panel.ZIndex="2"
                BorderThickness="0,0,0,0"
                BorderBrush="{DynamicResource Brushes.Quarternary.Border.Static}"
                Background="{DynamicResource Brushes.Secondary.Background.Hover}">
            <DockPanel>
                <TextBlock Margin="5,0,0,1"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Text="Data Explorer"
                           Foreground="{DynamicResource Brushes.Foreground.Static}" />
                <Button Width="20"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        DockPanel.Dock="Right"
                        Command="{Binding OpenAboutDialogCommand}">
                    <Button.Content>
                        <controls:IxIcon SegoeIcon="Help"
                                         Margin="0"
                                         Padding="0"
                                         Height="10" />
                    </Button.Content>
                </Button>
                <Button Width="20"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        DockPanel.Dock="Right"
                        ToolTip="Bulk Export"
                        Command="{Binding OpenBulkExportCommand}">
                    <Button.Content>
                        <controls:IxIcon SegoeIcon="SaveCopy"
                         Margin="0"
                         Padding="0"
                         Height="10" />
                    </Button.Content>
                </Button>
            </DockPanel>
            <Border.Effect>
                <DropShadowEffect Direction="270"
                                  ShadowDepth="1"
                                  BlurRadius="10"
                                  Color="#000" />
            </Border.Effect>
        </Border>

        <controls:IxTextBox Grid.Row="1"
                            Padding="2"
                            Panel.ZIndex="1"
                            PlaceholderText="Search"
                            Icon="{x:Static ui:SegoeIcon.Search}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            SearchHistory="{Binding SearchHistory}"
                            RemoveHistoryItemCommand="{Binding RemoveSearchCommand}"
                            SubmitTextCommand="{Binding SearchCommand}">
            <controls:IxTextBox.Style>
                <Style TargetType="{x:Type controls:IxTextBox}"
                       BasedOn="{StaticResource {x:Type controls:IxTextBox}}">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect x:Name="DropShadow"
                                                      ShadowDepth="1"
                                                      BlurRadius="10"
                                                      Opacity="1"
                                                      Color="#000" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </controls:IxTextBox.Style>
        </controls:IxTextBox>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Expander Grid.Row="0"
                      Header="Favorites"
                      IsExpanded="True"
                      Template="{StaticResource FavoriteExpanderTemplate}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="8,4,8,6"
                               Opacity="0.65"
                               Text="Right-click an asset and choose Add to Favorites."
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFavorites, Converter={StaticResource InverseVisibilityConverter}}" />
                    <ListBox ItemsSource="{Binding Favorites}"
                             MaxHeight="160"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnFavoriteSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnFavoriteClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button Width="18"
                                            Height="18"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            DockPanel.Dock="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding RemoveCommand}"
                                            Cursor="Hand"
                                            ToolTip="Remove">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE711;" />
                                    </Button>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Expander>

            <TreeView Grid.Row="1"
                      ItemsSource="{Binding NodesView}"
                      VirtualizingPanel.IsContainerVirtualizable="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItemChanged="OnAssetSelected">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding ChildrenView, IsAsync=True}">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}"
                           BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnAssetClick" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnNodeContextMenuOpening" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible, Mode=OneWay}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>

    </Grid>
</UserControl>
