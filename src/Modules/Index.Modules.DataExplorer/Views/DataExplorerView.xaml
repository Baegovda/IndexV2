<UserControl x:Class="Index.Modules.DataExplorer.Views.DataExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Index.Modules.DataExplorer.Views"
             xmlns:controls="clr-namespace:Index.UI.Controls;assembly=Index.UI"
             xmlns:commands="clr-namespace:Index.UI.Commands;assembly=Index.UI"
             xmlns:ui="clr-namespace:Index.UI;assembly=Index.UI"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Index.Modules.DataExplorer.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:DataExplorerViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="720"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Index.UI;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,8"
                Panel.ZIndex="2"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brushes.Quarternary.Border.Static}"
                Background="{DynamicResource Brushes.Secondary.Background.Hover}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Data Explorer"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brushes.Foreground.Static}" />
                    <TextBlock Margin="0,2,8,0"
                               Text="Double-click an asset to open it"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Bulk export"
                            Command="{Binding OpenBulkExportCommand}">
                        <controls:IxIcon SegoeIcon="SaveCopy"
                                         Width="14"
                                         Height="14" />
                    </Button>
                    <Button Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="About Index"
                            Command="{Binding OpenAboutDialogCommand}">
                        <controls:IxIcon SegoeIcon="Help"
                                         Width="14"
                                         Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:IxTextBox Grid.Row="1"
                            Padding="6,4"
                            Panel.ZIndex="1"
                            IsEnabled="{Binding IsInitialized}"
                            PlaceholderText="Search assets"
                            ToolTip="Search asset names"
                            Icon="{x:Static ui:SegoeIcon.Search}"
                            SubmitTextCommand="{Binding SearchCommand}">
            <controls:IxTextBox.Style>
                <Style TargetType="{x:Type controls:IxTextBox}"
                       BasedOn="{StaticResource {x:Type controls:IxTextBox}}">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect x:Name="DropShadow"
                                                      ShadowDepth="1"
                                                      BlurRadius="10"
                                                      Opacity="1"
                                                      Color="#000" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </controls:IxTextBox.Style>
        </controls:IxTextBox>

        <TreeView Grid.Row="2"
          ItemsSource="{Binding NodesView}"
          VirtualizingPanel.IsContainerVirtualizable="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingStackPanel.VirtualizationMode="Recycling"
          ScrollViewer.CanContentScroll="True">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding ChildrenView, IsAsync=True}">
                    <TextBlock Text="{Binding Name, Mode=OneWay}">
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DoubleClickCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}"
                       BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, Mode=OneWay}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <Border Grid.Row="2"
                Panel.ZIndex="3"
                Background="{DynamicResource Brushes.Background.Static}"
                Visibility="{Binding IsInitialized, Converter={StaticResource InverseVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16">
                <controls:IxSpinner Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Text="Loading assets..."
                           Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Panel.ZIndex="3"
                Background="{DynamicResource Brushes.Background.Static}"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInitialized}" Value="True" />
                                <Condition Binding="{Binding HasNodes}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="No assets were found for this game."
                       Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
        </Border>

        <Border Grid.Row="2"
                Panel.ZIndex="3"
                Background="{DynamicResource Brushes.Background.Static}"
                IsHitTestVisible="False"
                Visibility="{Binding ShowNoSearchResults, Converter={StaticResource VisibilityConverter}}">
            <TextBlock Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="No assets match that search."
                       Foreground="{DynamicResource Brushes.Foreground.Disabled}" />
        </Border>

    </Grid>
</UserControl>
