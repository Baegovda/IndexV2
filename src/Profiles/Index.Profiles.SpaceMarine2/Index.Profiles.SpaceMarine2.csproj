<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion>0.4.0.2</AssemblyVersion>
		<FileVersion>0.4.0.2</FileVersion>
		<Deterministic>false</Deterministic>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<ILRepackTargetsFile>$(MSBuildThisFileDirectory)..\DisableDefaultILRepack.targets</ILRepackTargetsFile>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber.SpaceMarine2\LibSaber.SpaceMarine2.csproj" />
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber\LibSaber.csproj" />
		<ProjectReference Include="..\..\Index.Core\Index.Core.csproj" />
		<ProjectReference Include="..\..\Index.Domain\Index.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" />
	</ItemGroup>

	<Target Name="RepackGameProfile" AfterTargets="Build">
		<PropertyGroup>
			<_ProfileDll>$(TargetDir)$(TargetFileName)</_ProfileDll>
			<_MergedDll>$(TargetDir)$(TargetName).merged.dll</_MergedDll>
			<_YamlDotNet>$(MSBuildThisFileDirectory)..\..\..\..\LibSaber\src\LibSaber.SpaceMarine2\bin\$(Configuration)\net8.0\YamlDotNet.dll</_YamlDotNet>
		</PropertyGroup>
		<ItemGroup>
			<_RepackInputs Include="$(_ProfileDll)" />
			<_RepackInputs Include="$(TargetDir)LibSaber.dll" />
			<_RepackInputs Include="$(TargetDir)LibSaber.SpaceMarine2.dll" />
			<_RepackInputs Include="$(_YamlDotNet)" />
		</ItemGroup>
		<ItemGroup>
			<_RepackLibraryPath Include="$(TargetDir)" />
			<_RepackLibraryPath Include="$(MSBuildThisFileDirectory)..\..\..\..\LibSaber\src\LibSaber.SpaceMarine2\bin\$(Configuration)\net8.0\" />
		</ItemGroup>
		<ILRepack
			Parallel="true"
			DebugInfo="true"
			InputAssemblies="@(_RepackInputs)"
			LibraryPath="@(_RepackLibraryPath)"
			OutputFile="$(_MergedDll)"
			TargetKind="SameAsPrimaryAssembly" />
		<Delete Files="$(_ProfileDll);$(TargetDir)$(TargetName).pdb" />
		<Move SourceFiles="$(_MergedDll)" DestinationFiles="$(_ProfileDll)" />
		<Move SourceFiles="$(TargetDir)$(TargetName).merged.pdb" DestinationFiles="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).merged.pdb')" />
	</Target>

	<Target Name="PostBuild" AfterTargets="RepackGameProfile">
		<Exec Command="mkdir &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles&quot;" ContinueOnError="true" />
		<Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles\$(TargetName).dll&quot;" />
		<Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles\$(TargetName).pdb&quot;" />
	</Target>

</Project>
