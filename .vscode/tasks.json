{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Suckdex.sln",
        "--configuration",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:ErrorsOnly;NoSummary;ForceNoAlign"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "revealProblems": "never",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "run",
      "dependsOn": "build",
      "dependsOrder": "sequence",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process -FilePath '${workspaceFolder}\\src\\Suckdex.App\\bin\\Debug\\net8.0-windows7.0\\Suckdex.exe'"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      }
    }
  ]
}
